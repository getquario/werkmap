{
  "$schema": "./node_modules/fallow/schema.json",
  // Reached by `tsc` through tsconfig's `include`, not by an import or a script
  // path, so it sits outside the graph fallow walks from package.json.
  "entry": ["test/types.check.ts"],
  // Served to the page by URL rather than imported from disk, so no import
  // names them and no path on disk answers to `/lib/index.js`.
  "dynamicallyLoaded": ["test/browser/browser.js"],
  "ignoreUnresolvedImports": ["/lib/index.js", "/fixture.js"],
  // Stryker resolves `testRunner: "tap"` to this package by naming convention at
  // run time, so no import or script path names it.
  "ignoreDependencies": ["@stryker-mutator/tap-runner"],
  "health": {
    "ignore": ["bench/**"],
  },
  "typeAware": {
    "enabled": true,
    "projects": ["tsconfig.json"],
    "require": "best-effort",
  },
}
